{
  "name": "vecinos-api-mock",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de Vecinos en Express. Las colecciones migradas viven en Firestore (ALMACEN=firestore); el resto sigue en memoria.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/servidor.ts",
    "start": "tsx --env-file-if-exists=.env src/servidor.ts",
    "typecheck": "tsc --noEmit",
    "sembrar": "tsx --env-file-if-exists=.env src/scripts/sembrar.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "firebase-admin": "^13.10.0",
    "geofire-common": "^6.0.0",
    "h3-js": "^4.5.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
