{
  "name": "vecinos-api-mock",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de datos simulados para la app Vecinos. Se reemplaza por MongoDB o Firestore módulo por módulo.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/servidor.ts",
    "start": "tsx src/servidor.ts",
    "typecheck": "tsc --noEmit",
