# Copia este archivo a .env (no se sube al repo). Sin .env, todo queda en memoria como antes.

# memoria | firestore. Con firestore se guardan en Firestore: usuarios, alertas, celdas, emergencias,
# sesiones, codigosClave, intentosIngreso, notificaciones, accionesProcesadas y archivos (fotos).
# El resto sigue en memoria. Con el emulador vacío: npm run sembrar
ALMACEN=firestore

FIREBASE_PROJECT_ID=vecinos-thelastcommit

# Opción recomendada para desarrollar: emulador local (no toca el proyecto real ni pide credenciales).
# Desde la raíz del repo: firebase emulators:start --only firestore   (UI en http://localhost:4000)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Cuentas: local (por defecto) | firebase. Con firebase, las cuentas y claves viven en Firebase Auth
# (recuperar clave por correo, verificación de correo, bloqueo de intentos).
# Con el emulador: firebase emulators:start --only firestore,auth y descomenta las dos líneas.
# AUTENTICACION=firebase
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Opción B: proyecto real. Comenta las líneas *_EMULATOR_HOST y usa una cuenta de servicio (Consola de
# Firebase → Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada), guardada
# en api-mock/credenciales/ (ignorado por git). También sirve `gcloud auth application-default login`.
# GOOGLE_APPLICATION_CREDENTIALS=./credenciales/cuenta-servicio.json
# Con AUTENTICACION=firebase en el proyecto real, también la clave de API web
# (Configuración del proyecto → General → Tus apps → app web → apiKey):
# FIREBASE_WEB_API_KEY=pega-aqui-la-clave-de-api-web
# FCM=si

# Fotos: se guardan en Firestore (colección archivos). Opcional, Cloud Storage del proyecto real:
# ARCHIVOS=storage
# FIREBASE_STORAGE_BUCKET=vecinos-thelastcommit.firebasestorage.app

# Modo local: «no» oculta el código de 6 dígitos en la respuesta (sigue saliendo en la consola).
# MOSTRAR_CODIGO_DEMO=no

# PORT=3000
# RETRASO_MS=0

# Modo emergencia (RF21–RF25). Por defecto, los valores del README.
# EMERGENCIA_MINIMO=3          # alertantes distintos (1 para probar con un teléfono)
# EMERGENCIA_PORCENTAJE=50     # deben ser MÁS de este % de los vecinos activos de la celda
# EMERGENCIA_INTERVALO_S=60    # reenvío de «¿Estás bien?»
# EMERGENCIA_CIERRE_MIN=30     # cierre sin alertas nuevas
