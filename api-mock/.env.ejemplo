# Copia este archivo a .env (no se sube al repo). Sin .env, todo queda en memoria como antes.

# memoria | firestore. Con firestore se guardan en Firestore: alertas, celdas, usuarios, sesiones,
# codigosClave, intentosIngreso, notificaciones, accionesProcesadas y archivos (fotos). El resto en memoria.
ALMACEN=firestore
FIREBASE_PROJECT_ID=vecinos-thelastcommit

# Cuentas: firebase | local. Con firebase, las cuentas y claves viven en Firebase Auth (recuperar clave
# por correo, verificación de correo). Sin esta línea, la API usa sus propias sesiones.
AUTENTICACION=firebase

# Emuladores (recomendado). Desde la raíz del repo: firebase emulators:start --only firestore,auth
# UI en http://localhost:4000 (Firestore, Authentication y los correos de recuperación).
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Proyecto real: comenta las dos líneas del emulador y completa estas (nunca subas la cuenta de servicio):
# GOOGLE_APPLICATION_CREDENTIALS=./credenciales/cuenta-servicio.json
# FIREBASE_WEB_API_KEY=pega-aqui-la-clave-de-api-web
# FCM=si

# Fotos: se guardan en Firestore (colección archivos). Opcional, Cloud Storage del proyecto real:
# ARCHIVOS=storage
# FIREBASE_STORAGE_BUCKET=vecinos-thelastcommit.firebasestorage.app

# Modo local: «no» oculta el código de 6 dígitos en la respuesta (sigue saliendo en la consola).
# MOSTRAR_CODIGO_DEMO=no

# PORT=3000
# RETRASO_MS=0
